{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actions Lights",
  "version": "1.9.0",
  "identifier": "com.luyz2000.actionslights",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "/popover",
        "width": 360,
        "height": 480,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      },
      {
        "label": "settings",
        "url": "/settings",
        "title": "Repos y workflows",
        "width": 840,
        "height": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQTdCN0QyMjE5ODFFRUEKUldUcUhwZ2gwcmVucmZwRTAxNi84ejdKbzl3K0JOVHN6OHRBWXNQd2tiZXNuWVlMYUhleWtJRDAK",
      "endpoints": [
        "https://github.com/luyz2000/actions-lights/releases/latest/download/latest.json"
      ]
    }
  }
}
